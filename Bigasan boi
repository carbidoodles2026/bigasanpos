<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BebeBigasan POS & Stock Tracker</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --accent: #10b981;
      --accent-hover: #059669;
      --warn: #f59e0b;
      --danger: #ef4444;
      --text: #f8fafc;
      --muted: #94a3b8;
      --border: #334155;
    }
    * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
    body { margin: 0; background: var(--bg); color: var(--text); padding: 16px; }
    .container { max-width: 1100px; margin: 0 auto; }
    header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border); padding-bottom: 12px; }
    h1 { margin: 0; font-size: 1.4rem; color: var(--accent); }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 20px; }
    .stat-box { background: var(--card); padding: 14px; border-radius: 10px; border: 1px solid var(--border); }
    .stat-label { font-size: 0.8rem; color: var(--muted); text-transform: uppercase; }
    .stat-val { font-size: 1.5rem; font-weight: 700; margin-top: 4px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }
    .card { background: var(--card); padding: 16px; border-radius: 10px; border: 1px solid var(--border); }
    .card h2 { margin-top: 0; font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
    label { display: block; font-size: 0.85rem; color: var(--muted); margin: 10px 0 4px; }
    select, input { width: 100%; padding: 10px; border-radius: 6px; border: 1px solid var(--border); background: #0f172a; color: var(--text); font-size: 1rem; }
    .quick-btns { display: flex; gap: 8px; margin-top: 8px; }
    .quick-btns button { flex: 1; background: #334155; color: var(--text); border: none; padding: 8px; border-radius: 6px; cursor: pointer; font-weight: 600; }
    .quick-btns button:hover { background: #475569; }
    .btn-primary { width: 100%; margin-top: 14px; padding: 12px; background: var(--accent); color: #052e16; border: none; border-radius: 8px; font-size: 1rem; font-weight: 700; cursor: pointer; }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-sm { padding: 6px 10px; border-radius: 6px; border: none; cursor: pointer; font-size: 0.8rem; font-weight: 600; }
    .btn-outline { background: transparent; border: 1px solid var(--border); color: var(--text); }
    .btn-danger { background: var(--danger); color: white; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.9rem; }
    th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-size: 0.8rem; }
    .low-stock { color: var(--warn); font-weight: 700; }
    .total-preview { background: #0f172a; padding: 10px; border-radius: 6px; margin-top: 10px; display: flex; justify-content: space-between; font-weight: 700; font-size: 1.1rem; }
  </style>
</head>
<body>
<div class="container">
  <header>
    <div>
      <h1>🌾 BebeBigasan POS & Stock Tracker</h1>
      <small style="color: var(--muted);">Auto-saves locally • Offline Ready</small>
    </div>
    <div style="display:flex; gap:8px;">
      <button class="btn-sm btn-outline" onclick="exportCSV()">📥 Export Excel (CSV)</button>
      <button class="btn-sm btn-danger" onclick="resetDay()">🔄 Reset Today's Sales</button>
    </div>
  </header>

  <div class="stats">
    <div class="stat-box">
      <div class="stat-label">Today's Gross Sales</div>
      <div class="stat-val" id="statSales">₱0.00</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Today's Net Profit</div>
      <div class="stat-val" style="color: var(--accent);" id="statProfit">₱0.00</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Total Kilos Sold</div>
      <div class="stat-val" id="statKilos">0 kg</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Remaining Total Stock</div>
      <div class="stat-val" id="statStock">0 kg</div>
    </div>
  </div>

  <div class="grid">
    <!-- POS / SELL SECTION -->
    <div class="card">
      <h2>🛒 Record Sale (Benta)</h2>
      <label>Rice Variety</label>
      <select id="sellVariety" onchange="updatePreview()"></select>

      <label>Kilos (kg)</label>
      <input type="number" id="sellKg" step="0.25" min="0.25" value="1" oninput="updatePreview()" />
      <div class="quick-btns">
        <button type="button" onclick="setKg(0.5)">½ kg</button>
        <button type="button" onclick="setKg(1)">1 kg</button>
        <button type="button" onclick="setKg(2)">2 kg</button>
        <button type="button" onclick="setKg(5)">5 kg</button>
        <button type="button" onclick="setKg(25)">½ Sako (25kg)</button>
      </div>

      <div class="total-preview">
        <span>Total Amount:</span>
        <span id="previewTotal" style="color: var(--accent);">₱0.00</span>
      </div>

      <button class="btn-primary" onclick="recordSale()">✅ Complete Sale (Cha-Ching!)</button>
    </div>

    <!-- INVENTORY & RESTOCK SECTION -->
    <div class="card">
      <h2>📦 Inventory & Restock (Sako / Kilo)</h2>
      <table>
        <thead>
          <tr>
            <th>Variety</th>
            <th>Price/kg</th>
            <th>Stock</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="inventoryTable"></tbody>
      </table>

      <h3 style="font-size:0.95rem; margin-top:16px; color:var(--muted);">+ Add New Rice Variety</h3>
      <div style="display:grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap:6px;">
        <input type="text" id="newName" placeholder="Name (e.g. Sinandomeng)" />
        <input type="number" id="newCost" placeholder="Cost/kg" />
        <input type="number" id="newPrice" placeholder="Sell/kg" />
        <input type="number" id="newSacks" placeholder="Sacks (50kg)" />
      </div>
      <button class="btn-sm btn-outline" style="width:100%; margin-top:8px;" onclick="addVariety()">+ Add Variety</button>
    </div>
  </div>

  <!-- RECENT TRANSACTIONS -->
  <div class="card" style="margin-top: 16px;">
    <h2>🧾 Today's Transaction Log</h2>
    <table>
      <thead>
        <tr>
          <th>Time</th>
          <th>Variety</th>
          <th>Kilos</th>
          <th>Total</th>
          <th>Profit</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="salesLog"></tbody>
    </table>
  </div>
</div>

<script>
  // Default initial rice varieties (editable & saved in browser localStorage)
  const defaultInventory = [
    { id: 1, name: "Dinorado", cost: 48, price: 56, stockKg: 100 },
    { id: 2, name: "Sinandomeng", cost: 44, price: 52, stockKg: 150 },
    { id: 3, name: "Jasmin", cost: 46, price: 54, stockKg: 100 },
    { id: 4, name: "Regular Milled", cost: 38, price: 45, stockKg: 200 }
  ];

  let inventory = JSON.parse(localStorage.getItem("bb_inventory")) || defaultInventory;
  let sales = JSON.parse(localStorage.getItem("bb_sales")) || [];

  // Built-in Cha-Ching Sound Synthesizer (Zero external files needed)
  function playChaChing() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const notes = [1046.50, 1318.51, 1567.98, 2093.00]; // C6, E6, G6, C7
      notes.forEach((freq, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.06);
        gain.gain.setValueAtTime(0.15, ctx.currentTime + idx * 0.06);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.06 + 0.35);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + idx * 0.06);
        osc.stop(ctx.currentTime + idx * 0.06 + 0.35);
      });
    } catch (e) {}
  }

  function saveState() {
    localStorage.setItem("bb_inventory", JSON.stringify(inventory));
    localStorage.setItem("bb_sales", JSON.stringify(sales));
    render();
  }

  function setKg(val) {
    document.getElementById("sellKg").value = val;
    updatePreview();
  }

  function updatePreview() {
    const id = Number(document.getElementById("sellVariety").value);
    const kg = Number(document.getElementById("sellKg").value) || 0;
    const item = inventory.find(i => i.id === id);
    const total = item ? item.price * kg : 0;
    document.getElementById("previewTotal").textContent = "₱" + total.toFixed(2);
  }

  function recordSale() {
    const id = Number(document.getElementById("sellVariety").value);
    const kg = Number(document.getElementById("sellKg").value);
    const item = inventory.find(i => i.id === id);

    if (!item || kg <= 0) return alert("Enter valid kilos.");
    if (item.stockKg < kg) return alert(`Kulang ang stock ng ${item.name}! (${item.stockKg} kg na lang)`);

    item.stockKg = Number((item.stockKg - kg).toFixed(2));
    const total = Number((item.price * kg).toFixed(2));
    const profit = Number(((item.price - item.cost) * kg).toFixed(2));

    sales.unshift({
      id: Date.now(),
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      varietyId: item.id,
      name: item.name,
      kg,
      total,
      profit
    });

    playChaChing();
    saveState();
  }

  function restockSack(id) {
    const item = inventory.find(i => i.id === id);
    if (!item) return;
    const sacks = prompt(`Ilang sako (50kg) ang idadagdag sa ${item.name}?`, "1");
    if (sacks && !isNaN(sacks) && Number(sacks) > 0) {
      item.stockKg = Number((item.stockKg + Number(sacks) * 50).toFixed(2));
      saveState();
    }
  }

  function editPrice(id) {
    const item = inventory.find(i => i.id === id);
    if (!item) return;
    const newPrice = prompt(`Bagong selling price per kilo para sa ${item.name}:`, item.price);
    if (newPrice && !isNaN(newPrice) && Number(newPrice) > 0) {
      item.price = Number(newPrice);
      saveState();
    }
  }

  function addVariety() {
    const name = document.getElementById("newName").value.trim();
    const cost = Number(document.getElementById("newCost").value);
    const price = Number(document.getElementById("newPrice").value);
    const sacks = Number(document.getElementById("newSacks").value) || 0;

    if (!name || cost <= 0 || price <= 0) return alert("Kumpletuhin ang Name, Cost, at Selling Price.");
    inventory.push({ id: Date.now(), name, cost, price, stockKg: sacks * 50 });

    document.getElementById("newName").value = "";
    document.getElementById("newCost").value = "";
    document.getElementById("newPrice").value = "";
    document.getElementById("newSacks").value = "";
    saveState();
  }

  function voidSale(saleId) {
    const idx = sales.findIndex(s => s.id === saleId);
    if (idx === -1) return;
    const sale = sales[idx];
    if (!confirm(`I-void ang ${sale.kg}kg ${sale.name} (₱${sale.total})? Ibabalik nito ang stock.`)) return;

    const item = inventory.find(i => i.id === sale.varietyId);
    if (item) item.stockKg = Number((item.stockKg + sale.kg).toFixed(2));
    sales.splice(idx, 1);
    saveState();
  }

  function resetDay() {
    if (confirm("Sigurado ka bang buburahin ang sales log ngayong araw? (Mananatili ang inventory stocks)")) {
      sales = [];
      saveState();
    }
  }

  function exportCSV() {
    let csv = "Time,Variety,Kilos,Total Sales,Net Profit\n";
    sales.forEach(s => {
      csv += `"${s.time}","${s.name}",${s.kg},${s.total},${s.profit}\n`;
    });
    const blob = new Blob([csv], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `BebeBigasan_Sales_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
  }

  function render() {
    // Dropdown
    const select = document.getElementById("sellVariety");
    const currentVal = select.value;
    select.innerHTML = inventory.map(i =>
      `<option value="${i.id}">${i.name} — ₱${i.price}/kg (${i.stockKg} kg left)</option>`
    ).join("");
    if (currentVal && inventory.some(i => i.id == currentVal)) select.value = currentVal;
    updatePreview();

    // Inventory Table
    document.getElementById("inventoryTable").innerHTML = inventory.map(i => {
      const sacks = (i.stockKg / 50).toFixed(1);
      const low = i.stockKg <= 25 ? "low-stock" : "";
      return `
        <tr>
          <td><strong>${i.name}</strong><br><small style="color:var(--muted)">Cost: ₱${i.cost}</small></td>
          <td>₱${i.price} <button class="btn-sm btn-outline" onclick="editPrice(${i.id})">✏️</button></td>
          <td class="${low}">${i.stockKg} kg<br><small>(${sacks} sako)</small></td>
          <td><button class="btn-sm btn-outline" onclick="restockSack(${i.id})">+ Sako</button></td>
        </tr>
      `;
    }).join("");

    // Sales Log
    document.getElementById("salesLog").innerHTML = sales.map(s => `
      <tr>
        <td>${s.time}</td>
        <td>${s.name}</td>
        <td>${s.kg} kg</td>
        <td>₱${s.total.toFixed(2)}</td>
        <td style="color:var(--accent)">₱${s.profit.toFixed(2)}</td>
        <td><button class="btn-sm btn-danger" onclick="voidSale(${s.id})">Void</button></td>
      </tr>
    `).join("");

    // Top Stats
    const totalSales = sales.reduce((acc, s) => acc + s.total, 0);
    const totalProfit = sales.reduce((acc, s) => acc + s.profit, 0);
    const totalKilos = sales.reduce((acc, s) => acc + s.kg, 0);
    const totalStock = inventory.reduce((acc, i) => acc + i.stockKg, 0);

    document.getElementById("statSales").textContent = "₱" + totalSales.toLocaleString("en-PH", { minimumFractionDigits: 2 });
    document.getElementById("statProfit").textContent = "₱" + totalProfit.toLocaleString("en-PH", { minimumFractionDigits: 2 });
    document.getElementById("statKilos").textContent = totalKilos.toFixed(2) + " kg";
    document.getElementById("statStock").textContent = totalStock.toFixed(1) + " kg";
  }

  render();
</script>
</body>
</html>
